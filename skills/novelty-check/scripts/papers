#!/bin/sh
# Runs the novelty-check search tool with whatever Python is available.
# Call it as `sh <skill dir>/scripts/papers <command> ...` (no executable bit needed).
DIR=$(cd "$(dirname "$0")" && pwd)
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$DIR/papers.py" "$@"
fi
if command -v nix >/dev/null 2>&1; then
  # NixOS often has no python3 on PATH.
  exec nix --extra-experimental-features 'nix-command flakes' run nixpkgs#python3 -- "$DIR/papers.py" "$@"
fi
echo "novelty-check: Python 3.9 or later is needed but python3 was not found." >&2
echo "Install it (macOS: xcode-select --install; Debian/Ubuntu: apt install python3)." >&2
exit 127
